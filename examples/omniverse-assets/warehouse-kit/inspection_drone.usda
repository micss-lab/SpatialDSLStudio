#usda 1.0
(
    defaultPrim = "InspectionDrone"
    documentation = "Project-authored CC0 inspection-drone visual. Base-normalized at Z=0; physics proxy is authored in the generated physics layer."
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "InspectionDrone"
{
    custom string spatialDsl:assetRole = "visual"
    custom string spatialDsl:license = "CC0-1.0"
    custom string spatialDsl:pivot = "base-center"

    def Cube "Body"
    {
        float size = 1
        color3f[] primvars:displayColor = [(0.34, 0.16, 0.62)]
        double3 xformOp:scale = (0.55, 0.34, 0.20)
        double3 xformOp:translate = (0, 0, 0.20)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "ArmX"
    {
        float size = 1
        color3f[] primvars:displayColor = [(0.55, 0.38, 0.82)]
        double3 xformOp:scale = (1.0, 0.08, 0.08)
        double3 xformOp:translate = (0, 0, 0.23)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "ArmY"
    {
        float size = 1
        color3f[] primvars:displayColor = [(0.55, 0.38, 0.82)]
        double3 xformOp:scale = (0.08, 1.0, 0.08)
        double3 xformOp:translate = (0, 0, 0.23)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "LandingSkidLeft"
    {
        float size = 1
        color3f[] primvars:displayColor = [(0.16, 0.18, 0.24)]
        double3 xformOp:scale = (0.55, 0.05, 0.08)
        double3 xformOp:translate = (0, -0.27, 0.04)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "LandingSkidRight"
    {
        float size = 1
        color3f[] primvars:displayColor = [(0.16, 0.18, 0.24)]
        double3 xformOp:scale = (0.55, 0.05, 0.08)
        double3 xformOp:translate = (0, 0.27, 0.04)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cylinder "RotorFront"
    {
        uniform token axis = "Z"
        float height = 0.025
        float radius = 0.20
        color3f[] primvars:displayColor = [(0.10, 0.12, 0.18)]
        double3 xformOp:translate = (0.50, 0, 0.31)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "RotorBack"
    {
        uniform token axis = "Z"
        float height = 0.025
        float radius = 0.20
        color3f[] primvars:displayColor = [(0.10, 0.12, 0.18)]
        double3 xformOp:translate = (-0.50, 0, 0.31)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "RotorLeft"
    {
        uniform token axis = "Z"
        float height = 0.025
        float radius = 0.20
        color3f[] primvars:displayColor = [(0.10, 0.12, 0.18)]
        double3 xformOp:translate = (0, -0.50, 0.31)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "RotorRight"
    {
        uniform token axis = "Z"
        float height = 0.025
        float radius = 0.20
        color3f[] primvars:displayColor = [(0.10, 0.12, 0.18)]
        double3 xformOp:translate = (0, 0.50, 0.31)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
