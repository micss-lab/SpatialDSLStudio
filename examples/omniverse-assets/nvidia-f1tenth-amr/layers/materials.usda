#usda 1.0
(
    documentation = "Portable UsdPreviewSurface materials for the SpatialDSL F1TENTH AMR."
)

over "F1TenthAMR"
{
    def Scope "Looks"
    {
        def Material "BodyRed"
        {
            token outputs:surface.connect = </F1TenthAMR/Looks/BodyRed/PBR.outputs:surface>
            def Shader "PBR"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.62, 0.018, 0.025)
                float inputs:metallic = 0.15
                float inputs:roughness = 0.28
                token outputs:surface
            }
        }

        def Material "Carbon"
        {
            token outputs:surface.connect = </F1TenthAMR/Looks/Carbon/PBR.outputs:surface>
            def Shader "PBR"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.022, 0.026, 0.032)
                float inputs:metallic = 0.35
                float inputs:roughness = 0.32
                token outputs:surface
            }
        }

        def Material "Rubber"
        {
            token outputs:surface.connect = </F1TenthAMR/Looks/Rubber/PBR.outputs:surface>
            def Shader "PBR"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.012, 0.014, 0.016)
                float inputs:roughness = 0.78
                token outputs:surface
            }
        }

        def Material "Aluminium"
        {
            token outputs:surface.connect = </F1TenthAMR/Looks/Aluminium/PBR.outputs:surface>
            def Shader "PBR"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.48, 0.52, 0.56)
                float inputs:metallic = 0.85
                float inputs:roughness = 0.22
                token outputs:surface
            }
        }

        def Material "SensorBlack"
        {
            token outputs:surface.connect = </F1TenthAMR/Looks/SensorBlack/PBR.outputs:surface>
            def Shader "PBR"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.025, 0.032, 0.042)
                float inputs:metallic = 0.05
                float inputs:roughness = 0.2
                token outputs:surface
            }
        }

        def Material "Lens"
        {
            token outputs:surface.connect = </F1TenthAMR/Looks/Lens/PBR.outputs:surface>
            def Shader "PBR"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.02, 0.12, 0.22)
                color3f inputs:emissiveColor = (0.01, 0.06, 0.11)
                float inputs:metallic = 0.1
                float inputs:roughness = 0.08
                token outputs:surface
            }
        }

        def Material "StatusBlue"
        {
            token outputs:surface.connect = </F1TenthAMR/Looks/StatusBlue/PBR.outputs:surface>
            def Shader "PBR"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.015, 0.18, 0.72)
                color3f inputs:emissiveColor = (0.02, 0.22, 0.95)
                float inputs:roughness = 0.25
                token outputs:surface
            }
        }
    }
}
