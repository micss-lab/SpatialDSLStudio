# Backend production environment example

DATABASE_URL=postgresql://postgres:replace_password@db:5432/modeling_tool?schema=public
PORT=3001
NODE_ENV=production

# Use your real frontend domain
CORS_ORIGIN=https://your-frontend-domain.com

MAX_FILE_SIZE=52428800
LOG_LEVEL=info

# Must be at least 32 characters
JWT_SECRET=replace-with-a-very-long-random-secret
JWT_EXPIRES_IN=7d

# Default admin account (created on first seed run)
ADMIN_EMAIL=haphantran@gmail.com
ADMIN_PASSWORD=replace-with-a-strong-password
