// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================
// Enums for Role-Based Access Control
// ===========================================

enum UserRole {
  ADMIN
  DSL_DESIGNER
  MODELER
  VIEWER
}

enum ResourceType {
  METAMODEL
  MODEL
  DIAGRAM
  TRANSFORMATION_RULE
  CODEGEN_PROJECT
  TEST_CASE
}

enum RoleRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SharePermission {
  VIEWER
  EDITOR
}

enum ProjectRole {
  OWNER
  DSL_DESIGNER
  MODELER
  VIEWER
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum MetamodelMigrationStatus {
  APPLIED
  FAILED
}

enum PipelineRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

// ===========================================
// User Authentication
// ===========================================

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String // Hashed with bcrypt
  role          UserRole  @default(VIEWER)
  emailVerified Boolean   @default(false)
  isSuspended   Boolean   @default(false)
  lastLogin     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations - user owns all their data
  ePackages           EPackage[]
  metamodels          Metamodel[]
  models              Model[]
  diagrams            Diagram[]
  transformationRules TransformationRule[]
  codegenProjects     CodeGenerationProject[]
  testCases           TestCase[]
  storedFiles         StoredFile[]
  viewpoints          Viewpoint[]

  // Project ownership and membership. Resource userId fields remain as
  // creator attribution during the project-scope migration.
  ownedProjects       StudioProject[]      @relation("ProjectOwner")
  projectMemberships  ProjectMembership[]
  projectCheckpoints  ProjectCheckpoint[]
  metamodelMigrations MetamodelMigration[]
  pipelineRuns        PipelineRun[]

  // Sharing relations
  ownedShares    SharedResource[] @relation("ShareOwner")
  receivedShares SharedResource[] @relation("ShareRecipient")

  // Password reset & role request relations
  passwordResetTokens    PasswordResetToken[]
  emailVerificationCodes EmailVerificationCode[]
  roleRequests           RoleRequest[]
  reviewedRoleRequests   RoleRequest[]           @relation("RoleRequestReviewer")

  @@map("users")
}

// ===========================================
// Studio Projects (workspace and security boundary)
// ===========================================

model StudioProject {
  id          String        @id @default(uuid())
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)

  ownerId String
  owner   User   @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships         ProjectMembership[]
  ePackages           EPackage[]
  metamodels          Metamodel[]
  viewpoints          Viewpoint[]
  models              Model[]
  diagrams            Diagram[]
  transformationRules TransformationRule[]
  codegenProjects     CodeGenerationProject[]
  testCases           TestCase[]
  storedFiles         StoredFile[]
  checkpoints         ProjectCheckpoint[]
  metamodelMigrations MetamodelMigration[]
  pipelineRuns        PipelineRun[]

  @@index([ownerId])
  @@index([status])
  @@map("studio_projects")
}

model ProjectMembership {
  id        String        @id @default(uuid())
  projectId String
  project   StudioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ProjectRole

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_memberships")
}

// Immutable, dependency-closed snapshots of the project artifact graph.
// Membership and authorization data are deliberately excluded from manifests.
model ProjectCheckpoint {
  id          String        @id @default(uuid())
  projectId   String
  project     StudioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sequence    Int
  tag         String?
  message     String?
  manifest    Json
  contentHash String
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime      @default(now())

  migrations   MetamodelMigration[]
  pipelineRuns PipelineRun[]

  @@unique([projectId, sequence])
  @@unique([projectId, tag])
  @@index([projectId, createdAt])
  @@map("project_checkpoints")
}

// Applied language-evolution operations and their impact/migration evidence.
model MetamodelMigration {
  id                 String                   @id @default(uuid())
  projectId          String
  project            StudioProject            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  metamodelId        String
  sourceCheckpointId String
  sourceCheckpoint   ProjectCheckpoint        @relation(fields: [sourceCheckpointId], references: [id], onDelete: Restrict)
  sourceHash         String
  targetHash         String
  status             MetamodelMigrationStatus
  changeSet          Json
  impactReport       Json
  migrationReport    Json
  createdById        String
  createdBy          User                     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt          DateTime                 @default(now())
  appliedAt          DateTime?

  @@index([projectId, metamodelId, createdAt])
  @@map("metamodel_migrations")
}

// Retained evidence for deterministic, headless project automation.
model PipelineRun {
  id                 String             @id @default(uuid())
  projectId          String
  project            StudioProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name               String
  status             PipelineRunStatus  @default(RUNNING)
  definition         Json
  result             Json?
  sourceCheckpointId String?
  sourceCheckpoint   ProjectCheckpoint? @relation(fields: [sourceCheckpointId], references: [id], onDelete: SetNull)
  contentHash        String?
  failureMessage     String?
  createdById        String
  createdBy          User               @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt          DateTime           @default(now())
  startedAt          DateTime           @default(now())
  completedAt        DateTime?

  @@index([projectId, createdAt])
  @@map("pipeline_runs")
}

// ===========================================
// Resource Sharing
// ===========================================

model SharedResource {
  id           String          @id @default(uuid())
  resourceType ResourceType
  resourceId   String
  permission   SharePermission

  // Owner of the resource
  ownerId String
  owner   User   @relation("ShareOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  // User the resource is shared with
  sharedWithId String
  sharedWith   User   @relation("ShareRecipient", fields: [sharedWithId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Same resource can't be shared twice with the same user
  @@unique([resourceType, resourceId, sharedWithId])
  @@map("shared_resources")
}

// ===========================================
// Meta-Metamodel (Ecore-like foundation)
// ===========================================

model EPackage {
  id       String @id @default(uuid())
  name     String
  nsURI    String
  nsPrefix String

  // Store the entire classes array as JSONB for flexibility
  // This includes EClass, EAttribute, EReference definitions
  classes Json @default("[]")

  // Owner
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String?
  project   StudioProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Metamodels that conform to this meta-metamodel
  metamodels Metamodel[]

  // Namespace identity is project-local. This lets one user own multiple
  // independent projects that each contain the standard Ecore package.
  @@unique([projectId, nsURI])
  @@index([projectId])
  @@map("e_packages")
}

// ===========================================
// Metamodel (User-defined schemas)
// ===========================================

model Metamodel {
  id          String  @id @default(uuid())
  name        String
  description String?
  uri         String
  prefix      String
  eClass      String? // ID of corresponding EClass in meta-metamodel

  // Store complex nested data as JSONB
  // classes: MetaClass[] with attributes, references, constraints
  classes Json @default("[]")
  enums   Json @default("[]")

  // Global constraints (OCL and JavaScript)
  constraints Json @default("[]")

  // Foreign key to meta-metamodel package
  conformsToId String
  conformsTo   EPackage @relation(fields: [conformsToId], references: [id])

  // Owner
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String?
  project   StudioProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  models     Model[]
  viewpoints Viewpoint[]

  @@index([projectId])
  @@map("metamodels")
}

// ===========================================
// Viewpoint (Sirius-style representation specification)
// ===========================================

model Viewpoint {
  id          String  @id @default(uuid())
  name        String
  description String?

  // Foreign key to semantic metamodel.
  metamodelId String
  metamodel   Metamodel @relation(fields: [metamodelId], references: [id], onDelete: Cascade)

  // Embedded RepresentationDescription[] for the first iteration.
  representationDescriptions Json    @default("[]")
  sharedConcreteSyntax       Json    @default("{}")
  isDefault                  Boolean @default(false)

  // Owner follows metamodel ownership/access.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String?
  project   StudioProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  diagrams Diagram[]

  @@unique([metamodelId, name, userId])
  @@index([projectId])
  @@map("viewpoints")
}

// ===========================================
// Model (Instances of metamodel)
// ===========================================

model Model {
  id          String  @id @default(uuid())
  name        String
  description String?
  metamodelId String // Duplicate for easy access

  // Store model elements as JSONB
  // elements: ModelElement[] with attributes, style, references
  elements Json @default("[]")

  // Optional connections for visualization
  connections Json @default("[]")

  // Foreign key to metamodel
  conformsToId String
  conformsTo   Metamodel @relation(fields: [conformsToId], references: [id], onDelete: Cascade)

  // Owner
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String?
  project   StudioProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  diagrams Diagram[]

  @@index([projectId])
  @@map("models")
}

// ===========================================
// Diagram (Visual representation)
// ===========================================

model Diagram {
  id          String  @id @default(uuid())
  name        String
  description String?

  // Foreign key to model
  modelId String
  model   Model  @relation(fields: [modelId], references: [id], onDelete: Cascade)

  // Store diagram elements as JSONB
  // elements: DiagramElement[] with positions, styles, etc.
  elements Json @default("[]")

  // Optional Sirius-style specification links. Diagram remains the current
  // compatibility table for concrete View / representation instances.
  viewpointId                 String?
  viewpoint                   Viewpoint? @relation(fields: [viewpointId], references: [id], onDelete: SetNull)
  representationDescriptionId String?

  // View membership for the model-backed projection contract.
  includedElementIds Json @default("[]")
  schemaVersion      Int  @default(2)
  migrationWarnings  Json @default("[]")

  // 3D grid settings
  gridSettings Json @default("{\"sizeX\": 20000, \"sizeY\": 20000}")

  // Owner
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String?
  project   StudioProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@map("diagrams")
}

// ===========================================
// Transformation System (Simplified)
// ===========================================

// Single table for transformation rules with embedded patterns
model TransformationRule {
  id          String  @id @default(uuid())
  name        String
  description String?
  priority    Int     @default(0)
  enabled     Boolean @default(true)

  // LHS Pattern (embedded as JSON)
  lhs Json @default("{}")

  // RHS Pattern (embedded as JSON)
  rhs Json @default("{}")

  // NAC Patterns (embedded as JSON array)
  nacs Json @default("[]")

  // Additional application conditions
  conditions Json @default("[]")

  // Optional reference to diagram visualization
  diagramId String?

  // Owner
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String?
  project   StudioProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@map("transformation_rules")
}

// ===========================================
// Code Generation
// ===========================================

model CodeGenerationProject {
  id          String  @id @default(uuid())
  name        String
  description String?
  isExample   Boolean @default(false)

  // Target metamodel ID (stored as string without foreign key for example projects)
  targetMetamodelId String?

  // Store templates as JSONB
  // templates: CodeGenerationTemplate[]
  templates Json @default("[]")

  // Owner
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String?
  project   StudioProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@map("code_generation_projects")
}

// ===========================================
// Test Cases
// ===========================================

model TestCase {
  id                  String         @id @default(uuid())
  name                String
  description         String?
  type                TestCaseType
  targetMetaClassId   String
  targetMetaClassName String
  targetProperty      String?
  status              TestCaseStatus @default(pending)
  errorMessage        String?

  // For constraint tests
  constraintId   String?
  constraintType ConstraintType?

  // Test inputs/outputs
  originalInput  Json?
  expectedOutput Json?
  actualOutput   Json?

  // Test values as JSONB
  testValues Json @default("[]")

  // Target ID - can be model or metamodel ID (no foreign key constraint for flexibility)
  modelId String?

  // Owner
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String?
  project   StudioProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@map("test_cases")
}

enum TestCaseType {
  attribute
  reference
  constraint
  reference_attribute
}

enum TestCaseStatus {
  pending
  running
  passed
  failed
}

enum ConstraintType {
  ocl
  javascript
}

// ===========================================
// File Storage (GLB models, images)
// ===========================================

model StoredFile {
  id       String   @id @default(uuid())
  filename String
  mimetype String
  size     Int
  type     FileType

  // Store the actual file data as bytes
  data Bytes

  // Metadata
  metadata Json @default("{}")

  // Owner
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String?
  project   StudioProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@map("stored_files")
}

enum FileType {
  image
  model
  other
}

// ===========================================
// Password Reset Tokens
// ===========================================

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique @map("token_hash")
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("password_reset_tokens")
}

model EmailVerificationCode {
  id        String    @id @default(uuid())
  codeHash  String    @map("code_hash")
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, usedAt])
  @@map("email_verification_codes")
}

// ===========================================
// Role Requests
// ===========================================

model RoleRequest {
  id            String            @id @default(uuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentRole   UserRole
  requestedRole UserRole
  reason        String
  status        RoleRequestStatus @default(PENDING)
  reviewedById  String?
  reviewedBy    User?             @relation("RoleRequestReviewer", fields: [reviewedById], references: [id])
  reviewNote    String?
  reviewedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@map("role_requests")
}
